SPRING_APPLICATION_NAME=identity-access-service
SPRING_PROFILES_ACTIVE=docker
SERVER_PORT=8081
APP_TIMEZONE=America/Guayaquil

IDENTITY_DB_URL=jdbc:mysql://mysql-identity:3306/banquito_identity_access_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=America/Guayaquil
IDENTITY_DB_USER=banquito_app
IDENTITY_DB_PASSWORD=change_me_identity_db_password

DB_MAX_POOL_SIZE=10
DB_MIN_IDLE=2
DB_CONNECTION_TIMEOUT_MS=30000

JPA_DDL_AUTO=validate
HIBERNATE_FORMAT_SQL=false
FLYWAY_ENABLED=true
FLYWAY_BASELINE_ON_MIGRATE=true
FLYWAY_BASELINE_VERSION=1

ACTUATOR_ENDPOINTS=health,info
ACTUATOR_HEALTH_DETAILS=always
OPENAPI_DOCS_PATH=/api-docs
SWAGGER_UI_PATH=/swagger-ui.html

JWT_ISSUER=banquito-identity-access
JWT_SECRET=change_me_shared_jwt_secret
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_ISSUER=https://accounts.google.com
GOOGLE_OAUTH_JWK_SET_URI=https://www.googleapis.com/oauth2/v3/certs

DEMO_DATA_ENABLED=true
DEMO_PASSWORD=change_me_demo_password
BANQUITO_CUSTOMER_ACTIVATION_BASE_URL=http://localhost:5174/activar
ADMIN_SERVICE_BASE_URL=http://core-admin-service:8083
NOTIFICATION_SERVICE_BASE_URL=http://notification-service:8087
INTERNAL_SERVICE_KEY=change_me_internal_service_key

IDENTITY_OUTBOX_ENABLED=true
IDENTITY_OUTBOX_BATCH_SIZE=20
IDENTITY_OUTBOX_MAX_ATTEMPTS=5
IDENTITY_OUTBOX_FIXED_DELAY_MS=5000
